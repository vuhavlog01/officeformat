<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VFormat.UI.TaskPane.TaskPaneView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:version="clr-namespace:VFormat.Core.Common;assembly=VFormat.Core" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VFormat.UI.TaskPane" FontFamily="Segoe UI, Tahoma, Arial">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentControls.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource BrushWindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,0,0,1" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource BrushPrimaryGradient}" Margin="0,0,10,0">
            <Path Data="{StaticResource IconWand}" Fill="{StaticResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{x:Static version:Constants.AppDisplayNameUpper}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushTextPrimary}" />
            <TextBlock Text="Chuẩn hóa Thể thức Word" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource FluentActionButton}" Padding="8,4" VerticalAlignment="Center" ToolTip="Xem thông tin và kích hoạt bản quyền" Command="{Binding OpenLicenseCommand}">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IconShield}" Fill="{StaticResource BrushSuccess}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccessText}" VerticalAlignment="Center" Text="{Binding LicenseStatusBadge}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14">
      <StackPanel>
        <Border Style="{StaticResource FluentCard}">
          <StackPanel>
            <TextBlock Text="QUY CHUẨN VĂN BẢN" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,8" />
            <ComboBox SelectedValuePath="Type" DisplayMemberPath="Title" Style="{StaticResource FluentComboBox}" Margin="0,0,0,6" ItemsSource="{Binding RulePackOptions}" SelectedValue="{Binding SelectedRulePack}" />
            <TextBlock Text="Tự động nhận diện khi mở văn bản; có thể chọn lại quy chuẩn thủ công." FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource FluentCard}">
          <StackPanel>
            <Button Style="{StaticResource FluentPrimaryButton}" Height="46" Margin="0,0,0,8" ToolTip="Chuẩn hóa toàn bộ văn bản từ đầu đến cuối theo quy chuẩn" Command="{Binding StandardizeAllCommand}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconWand}" Fill="{StaticResource BrushTextWhite}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="CHUẨN HÓA TOÀN VĂN" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource FluentSecondaryButton}" Height="36" ToolTip="Chỉ chuẩn hóa các đoạn văn bản đang được bôi đen chọn" Command="{Binding StandardizeSelectionCommand}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconDocument}" Fill="{StaticResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Chuẩn Hóa Vùng Chọn" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource FluentActionButton}" Height="36" Margin="0,8,0,0" ToolTip="Kiểm soát lỗi chính tả, dấu câu, viết hoa và viết tắt 100% Offline" Command="{Binding OpenSpellCheckCommand}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconSpellCheck}" Fill="{StaticResource BrushPrimary}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="Kiểm Tra Chính Tả Tiếng Việt" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource FluentActionButton}" Height="36" Margin="0,8,0,0" ToolTip="Khám phá và sử dụng toàn bộ biểu mẫu chuẩn Quốc gia (Thi đua – Khen thưởng NĐ 152, Hành chính NĐ 30, Đảng HD 05...)" Command="{Binding OpenTemplateLibraryCommand}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconBookOpen}" Fill="{StaticResource BrushPrimary}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="Thư Viện Biểu Mẫu Chuẩn" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource FluentCard}">
          <StackPanel>
            <TextBlock Text="CÁC MỤC CHUẨN HÓA" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,6" />
            <CheckBox Content="Khổ giấy A4 và Lề chuẩn (20-20-30-15mm)" Style="{StaticResource FluentCheckBox}" IsChecked="{Binding OptPageSetup}" />
            <CheckBox Content="Font Times New Roman &amp; Giãn dòng chuẩn" Style="{StaticResource FluentCheckBox}" IsChecked="{Binding OptTypography}" />
            <CheckBox Content="Bảng biểu (Căn giữa, lặp tiêu đề, chống tách dòng)" Style="{StaticResource FluentCheckBox}" IsChecked="{Binding OptTables}" />
            <CheckBox Content="Đánh số trang lề trên căn giữa (ẩn trang 1)" Style="{StaticResource FluentCheckBox}" IsChecked="{Binding OptPageNumbers}" />
            <Separator Margin="0,8,0,8" Background="{StaticResource BrushSeparator}" />
            <TextBlock Text="BỐ CỤC IN / GỬI FILE" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
            <ComboBox SelectedValuePath="Type" DisplayMemberPath="Title" Style="{StaticResource FluentComboBox}" Margin="0,0,0,4" ItemsSource="{Binding PrintLayoutOptions}" SelectedValue="{Binding SelectedPrintLayout}" />
            <TextBlock Text="Chọn 'Gửi file' để giữ lề phẳng đều đẹp; 'In 2 mặt' để so le lề gáy theo quy chuẩn." FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource FluentCard}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <TextBlock Text="CÁ NHÂN HÓA VĂN BẢN" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
              <Button Content="Cấu hình..." HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource BrushPrimary}" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding OpenPersonalizationCommand}" />
            </Grid>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Style="{StaticResource FluentActionButton}" Command="{Binding InsertHeaderCommand}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IconBuilding}" Fill="{StaticResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="Chèn Tiêu Đề" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Style="{StaticResource FluentActionButton}" Command="{Binding InsertSignerCommand}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IconPen}" Fill="{StaticResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="Chèn Chữ Ký" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,0" Padding="14,10">
      <StackPanel>
        <ProgressBar Maximum="100" Style="{StaticResource FluentProgressBar}" Margin="0,0,0,8" Value="{Binding ProgressValue}" />
        <Grid>
          <TextBlock FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding StatusMessage}" />
          <TextBlock Text="Ctrl + Z để hoàn tác" FontSize="10" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
