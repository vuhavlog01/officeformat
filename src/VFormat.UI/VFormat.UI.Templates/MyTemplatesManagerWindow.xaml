<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="VFormat.UI.Templates.MyTemplatesManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quản Lý Biểu Mẫu Của Tôi - OfficeFormat" Height="580" Width="840" MinHeight="480" MinWidth="700" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Tahoma, Arial" Background="#FDF8F4" xmlns:templates="clr-namespace:VFormat.UI.Templates;assembly=VFormat.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentColors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentControls.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/VectorIcons.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource BrushWindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="0,0,0,1" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="{StaticResource IconStar}" Fill="{DynamicResource BrushPrimary}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="BIỂU MẪU CỦA TÔI" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Kho lưu trữ biểu mẫu văn bản cá nhân - Mở văn bản mới không sợ đè lên mẫu, thay thế và quản lý thuận tiện." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="24,3,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="📂 Mở thư mục lưu trữ" Height="32" Padding="12,0" Style="{DynamicResource FluentSecondaryButton}" VerticalAlignment="Center" Click="BtnOpenFolder_Click" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource BrushSubtle}" BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="0,0,0,1" Padding="20,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="15" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Name="txtSearch" Grid.Column="0" Height="32" VerticalContentAlignment="Center" Padding="8,0" Style="{DynamicResource FluentTextBox}" TextChanged="TxtSearch_TextChanged" />
        <TextBlock Name="lblSearchWatermark" Grid.Column="0" Text="🔍 Tìm kiếm biểu mẫu theo tên..." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource BrushTextMuted}" IsHitTestVisible="False" />
        <TextBlock Name="lblItemCount" Grid.Column="2" Text="Tổng số: 0 biểu mẫu" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold" />
      </Grid>
    </Border>
    <Grid Row="2" Margin="20,14,20,14">
      <ListView Name="lvTemplates" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" SelectionMode="Single" SelectionChanged="LvTemplates_SelectionChanged" MouseDoubleClick="LvTemplates_MouseDoubleClick">
        <ListView.View>
          <GridView>
            <GridViewColumn Width="45">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Path Data="{StaticResource IconDocument}" Fill="{DynamicResource BrushPrimary}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Tên biểu mẫu" Width="320">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center" Margin="2,3">
                    <TextBlock FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" Text="{Binding Name}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Text="{Binding Description}" />
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Tên tệp tin" Width="180">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Text="{Binding FileName}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Ngày sửa đổi" Width="130">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Text="{Binding FormattedDate}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Dung lượng" Width="90">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Text="{Binding FormattedSize}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
      <StackPanel Name="pnlEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
        <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource BrushPrimary}" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
        <TextBlock Text="Chưa có biểu mẫu cá nhân nào trong thư viện" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Text="Nhấn nút 'Thêm biểu mẫu mới' bên dưới để nhập tệp Word mẫu đầu tiên của bạn." FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,14" />
        <Button Content="➕ Thêm biểu mẫu mới ngay" Height="34" Width="200" HorizontalAlignment="Center" Style="{DynamicResource FluentPrimaryButton}" Click="BtnAdd_Click" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Name="btnAdd" Content="➕ Thêm mẫu mới" Height="34" Padding="12,0" Margin="0,0,8,0" Style="{DynamicResource FluentSecondaryButton}" Click="BtnAdd_Click" />
          <Button Name="btnReplace" Content="🔄 Thay thế file..." Height="34" Padding="12,0" Margin="0,0,8,0" Style="{DynamicResource FluentSecondaryButton}" IsEnabled="False" Click="BtnReplace_Click" />
          <Button Name="btnRename" Content="✏️ Đổi tên" Height="34" Padding="12,0" Margin="0,0,8,0" Style="{DynamicResource FluentSecondaryButton}" IsEnabled="False" Click="BtnRename_Click" />
          <Button Name="btnDelete" Content="🗑️ Xóa mẫu" Height="34" Padding="12,0" Style="{DynamicResource FluentSecondaryButton}" IsEnabled="False" Click="BtnDelete_Click" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Đóng" Width="80" Height="34" Margin="0,0,10,0" Style="{DynamicResource FluentSecondaryButton}" IsCancel="True" Click="BtnClose_Click" />
          <Button Name="btnUseTemplate" Content="★ Sử dụng mẫu này" Height="34" Padding="18,0" Style="{DynamicResource FluentPrimaryButton}" IsDefault="True" IsEnabled="False" Click="BtnUseTemplate_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>