<Window x:Class="VFormat.UI.Common.PdfConverterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chuyển đổi PDF sang Word" Height="520" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI">

  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentColors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentControls.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/VectorIcons.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>

  <Grid Background="{StaticResource BrushWindowBackground}">
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Chuyển đổi PDF sang Word" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}" />
      <TextBlock Text="Chuyển đổi tệp PDF sang tài liệu Word giữ nguyên thể thức, căn lề và bảng biểu" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
    </StackPanel>

    <!-- Main Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
      <StackPanel>
        <!-- Card 1: Chọn file PDF -->
        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,10">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="DANH SÁCH FILE PDF CẦN CHUYỂN ĐỔI:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="+ Thêm File PDF..." Style="{StaticResource FluentSecondaryButton}" Height="26" Padding="8,2" Margin="0,0,6,0" Click="BtnAddFiles_Click" />
              <Button Grid.Column="2" Content="Xóa danh sách" Style="{StaticResource FluentSecondaryButton}" Height="26" Padding="8,2" Click="BtnClearFiles_Click" />
            </Grid>
            
            <ListBox x:Name="lstFiles" Height="140" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1" Background="White" FontSize="11.5" AllowDrop="True" Drop="LstFiles_Drop" DragOver="LstFiles_DragOver" />
            <TextBlock Text="💡 Bạn có thể kéo thả trực tiếp một hoặc nhiều file PDF vào khung trên." FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <!-- Card 2: Cấu hình chuyển đổi -->
        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,10">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <TextBlock Text="CHẾ ĐỘ &amp; TÙY CHỌN CHUYỂN ĐỔI:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
              <Border HorizontalAlignment="Right" Background="#E8F5E9" CornerRadius="4" Padding="6,2">
                <TextBlock x:Name="txtEngineBadge" Text="⚡ Chuẩn thể thức văn bản" FontSize="10" FontWeight="SemiBold" Foreground="#2E7D32" />
              </Border>
            </Grid>
            <CheckBox x:Name="chkPreserveLayout" Content="Tự động căn chỉnh và giữ nguyên cấu trúc bảng biểu" IsChecked="True" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,6" />
            <CheckBox x:Name="chkOpenAfterConvert" Content="Tự động mở file Word sau khi chuyển đổi xong" IsChecked="True" FontSize="11.5" Margin="0,0,0,4" />
          </StackPanel>
        </Border>

        <!-- Card 3: Thư mục lưu kết quả -->
        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="THƯ MỤC LƯU FILE KẾT QUẢ (.DOCX):" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
            <RadioButton x:Name="rbSameFolder" GroupName="OutFolder" Content="Lưu cùng thư mục với file PDF gốc (Khuyên dùng)" IsChecked="True" FontSize="11.5" Margin="0,0,0,6" />
            <RadioButton x:Name="rbCustomFolder" GroupName="OutFolder" Content="Lưu vào thư mục tùy chọn:" FontSize="11.5" Margin="0,0,0,4" />
            <Grid Margin="22,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="txtCustomFolder" Style="{StaticResource FluentTextBox}" Height="28" Padding="6,2" VerticalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=rbCustomFolder}" />
              <Button Grid.Column="1" Content="Duyệt..." Style="{StaticResource FluentSecondaryButton}" Height="30" MinWidth="75" Margin="6,0,0,0" IsEnabled="{Binding IsChecked, ElementName=rbCustomFolder}" Click="BtnBrowseFolder_Click" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Thanh tiến trình & Trạng thái -->
        <ProgressBar x:Name="progressBar" Height="8" Margin="0,0,0,4" Visibility="Collapsed" />
        <TextBlock x:Name="txtStatus" Text="" FontSize="11" Foreground="{StaticResource BrushPrimary}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <!-- Footer buttons -->
    <Border Grid.Row="2" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="btnOpenCurrentFolder" Content="Mở thư mục" MinWidth="110" Height="35" Margin="0,0,8,0" Style="{StaticResource FluentSecondaryButton}" Click="BtnOpenFolder_Click" />
        <Button x:Name="btnStartConvert" Content="Bắt đầu chuyển đổi" MinWidth="165" Height="35" Margin="0,0,8,0" Style="{StaticResource FluentPrimaryButton}" Click="BtnStartConvert_Click" />
        <Button x:Name="btnClose" Content="Đóng" MinWidth="80" Height="35" Style="{StaticResource FluentSecondaryButton}" Click="BtnClose_Click" />
      </StackPanel>
    </Border>
    </Grid>
  </Grid>
</Window>
