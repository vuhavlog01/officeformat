<Window x:Class="VFormat.UI.Common.PdfPageOrganizerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trình Sắp Xếp Trang PDF Trực Quan - OfficeFormat"
        Height="680" Width="880"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        MinHeight="550" MinWidth="720"
        FontFamily="Segoe UI">

  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentColors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentControls.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/VectorIcons.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>

  <Grid Background="{StaticResource BrushWindowBackground}">
    <Grid Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Row 0: Header -->
      <Border Grid.Row="0" Background="{StaticResource BrushCardBackground}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
              BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="SẮP XẾP TRANG PDF TRỰC QUAN" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" />
              <TextBlock x:Name="txtFileName" Text=" - tài_liệu.pdf" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
            </StackPanel>
            <TextBlock Text="Chọn trang để lùi, tiến, xoay 90° hoặc xóa trang. Hỗ trợ nhập chuỗi thứ tự nhanh như '1, 3, 2' hoặc '1-5, 8, 7-6'."
                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
          </StackPanel>

          <Border Grid.Column="1" Background="{StaticResource BrushPrimaryLight}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
            <TextBlock x:Name="txtSummaryBadge" Text="0 trang" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" />
          </Border>
        </Grid>
      </Border>

      <!-- Row 1: Toolbar Actions & Quick Sequence -->
      <Border Grid.Row="1" Style="{StaticResource FluentCard}" Margin="0,0,0,10" Padding="10,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Top Toolbar: Reorder / Rotate buttons -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="⬅ Lùi 1 vị trí" Style="{StaticResource FluentSecondaryButton}" Height="28" Padding="10,2" Margin="0,0,6,0" Click="BtnMoveLeft_Click" />
            <Button Content="Tiến 1 vị trí ➡" Style="{StaticResource FluentSecondaryButton}" Height="28" Padding="10,2" Margin="0,0,6,0" Click="BtnMoveRight_Click" />
            <Button Content="🔄 Xoay 90°" Style="{StaticResource FluentSecondaryButton}" Height="28" Padding="10,2" Margin="0,0,6,0" Click="BtnRotate_Click" />
            <Button Content="❌ Xóa trang" Style="{StaticResource FluentSecondaryButton}" Height="28" Padding="10,2" Margin="0,0,12,0" Click="BtnDelete_Click" />
            <Button Content="↕ Đảo ngược toàn bộ" Style="{StaticResource FluentSecondaryButton}" Height="28" Padding="10,2" Margin="0,0,6,0" Click="BtnReverseAll_Click" />
            <Button Content="↺ Khôi phục ban đầu" Style="{StaticResource FluentSecondaryButton}" Height="28" Padding="10,2" Click="BtnReset_Click" />
          </StackPanel>

          <!-- Quick sequence string -->
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Nhập thứ tự nhanh (VD: 1, 3, 2 hoặc 5-1):" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" x:Name="txtOrderSpec" Height="26" FontSize="11.5" Padding="6,2" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="Áp dụng thứ tự" Style="{StaticResource FluentSecondaryButton}" Height="26" Padding="12,2" Margin="6,0,0,0" Click="BtnApplyOrderSpec_Click" />
          </Grid>
        </Grid>
      </Border>

      <!-- Row 2: Visual Grid of Page Thumbnails -->
      <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <WrapPanel x:Name="pnlPages" Orientation="Horizontal" />
        </ScrollViewer>
      </Border>

      <!-- Row 3: Current Order Summary -->
      <Border Grid.Row="3" Background="{StaticResource BrushSubtle}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Thứ tự trang xuất ra: " FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="txtCurrentOrder" Text="1, 2, 3..." FontSize="11" Foreground="{StaticResource BrushTextPrimary}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- Row 4: Bottom Actions -->
      <Grid Grid.Row="4" Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="Chọn thẻ trang và nhấn phím mũi tên hoặc nút bấm để điều chỉnh."
                   FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />

        <Button Grid.Column="1" x:Name="btnExport" Content="💾 Xuất tệp PDF đã sắp xếp..."
                Style="{StaticResource FluentPrimaryButton}" Height="34" Padding="18,4" Margin="0,0,8,0" Click="BtnExport_Click" />

        <Button Grid.Column="2" Content="Đóng" Style="{StaticResource FluentSecondaryButton}" Height="34" Padding="14,4" Click="BtnClose_Click" />
      </Grid>

    </Grid>
  </Grid>
</Window>
