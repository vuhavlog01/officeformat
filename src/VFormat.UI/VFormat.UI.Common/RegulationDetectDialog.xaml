<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="VFormat.UI.Common.RegulationDetectDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Title="OfficeFormat - NHẬN DIỆN THỂ THỨC VĂN BẢN" Width="500" Height="430" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontFamily="Segoe UI, Tahoma, Arial" xmlns:common="clr-namespace:VFormat.UI.Common;assembly=VFormat.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentColors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentControls.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/VectorIcons.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource BrushWindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="{StaticResource BrushPrimaryLight}" Margin="0,0,12,0" VerticalAlignment="Center">
          <Path Data="{StaticResource IconWand}" Fill="{StaticResource BrushPrimary}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="KẾT QUẢ NHẬN DIỆN THỂ THỨC VĂN BẢN" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" />
          <TextBlock Text="Tự động phân tích cấu trúc tiêu đề, số hiệu &amp; nội dung tài liệu Word." FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
      <StackPanel>
        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,12" Background="#F0FDF4" BorderBrush="#BBF7D0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#DCFCE7" Margin="0,0,12,0" VerticalAlignment="Center">
              <Path Data="{StaticResource IconCheck}" Fill="#16A34A" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="QUY CHUẨN ĐƯỢC NHẬN DIỆN" FontSize="10.5" FontWeight="Bold" Foreground="#15803D" />
              <TextBlock Name="txtRegulationName" Text="Hành chính Nhà nước (Nghị định 30/2020/NĐ-CP)" FontSize="13.5" FontWeight="Bold" Foreground="#14532D" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource FluentCard}">
          <StackPanel>
            <TextBlock Text="THÔNG TIN THỂ THỨC &amp; THÔNG SỐ ÁP DỤNG" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Cơ quan ban hành:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
              <TextBlock Name="txtAgency" Grid.Column="1" Text="Tự động trích xuất từ văn bản" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Số ký hiệu:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
              <TextBlock Name="txtDocNumber" Grid.Column="1" Text="Tự động nhận diện" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
            </Grid>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Cỡ chữ &amp; Dãn dòng:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
              <TextBlock Name="txtTypography" Grid.Column="1" Text="Font 14pt, giãn dòng 1.15 lines, cách đoạn 6pt" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Căn lề khổ A4:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
              <TextBlock Name="txtMargins" Grid.Column="1" Text="Trên 20, Dưới 20, Trái 30, Phải 15-20 mm" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,0" Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Name="btnClose" Content="Đóng" Style="{StaticResource FluentSecondaryButton}" Height="36" MinWidth="90" Margin="0,0,10,0" Click="BtnClose_Click" />
        <Button Name="btnApply" Content="Áp Dụng Cấu Hình Này" Style="{StaticResource FluentPrimaryButton}" Height="36" MinWidth="160" Click="BtnApply_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
