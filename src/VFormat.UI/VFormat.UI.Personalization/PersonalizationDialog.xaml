                    <StackPanel>
                      <TextBlock Text="Ví dụ: 2.345 → Bật: &quot;Hai nghìn ba trăm bốn mươi lăm đồng&quot;" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,1" />
                      <TextBlock Text="              Tắt: &quot;hai nghìn ba trăm bốn mươi lăm đồng&quot;" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,1" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource FluentCard}" Padding="12,10">
                <StackPanel>
                  <TextBlock Text="Cách đọc hàng chục bằng 0" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" />
                  <TextBlock Text="Dùng khi hàng chục là 0 nhưng hàng đơn vị khác 0 (105, 2.007...)." FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,8" />
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Content="linh (mặc định)" GroupName="AmountZeroTensGroup" Style="{StaticResource FluentSegmentedRadioButton}" IsChecked="{Binding AmountZeroTensAsLinh}" />
                    <RadioButton Content="lẻ" GroupName="AmountZeroTensGroup" Style="{StaticResource FluentSegmentedRadioButton}" IsChecked="{Binding AmountZeroTensAsLe}" />
                  </StackPanel>
                  <Border Background="{StaticResource BrushPrimaryLight}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
                    <StackPanel>
                      <TextBlock Text="Ví dụ: 105 → linh: &quot;Một trăm linh năm đồng&quot;  ·  lẻ: &quot;Một trăm lẻ năm đồng&quot;" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,1" />
                      <TextBlock Text="Ví dụ: 1.005 → linh: &quot;Một nghìn không trăm linh năm đồng&quot;  ·  lẻ: &quot;…không trăm lẻ năm đồng&quot;" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,1" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource FluentCard}" Padding="12,10">
                <StackPanel>
                  <TextBlock Text="Cách đọc hàng nghìn" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" />
                  <TextBlock Text="Áp dụng cho mọi hàng nghìn, kể cả &quot;nghìn tỷ&quot;." FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,8" />
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Content="nghìn (mặc định)" GroupName="AmountThousandGroup" Style="{StaticResource FluentSegmentedRadioButton}" IsChecked="{Binding AmountThousandAsNghin}" />
                    <RadioButton Content="ngàn" GroupName="AmountThousandGroup" Style="{StaticResource FluentSegmentedRadioButton}" IsChecked="{Binding AmountThousandAsNgan}" />
                  </StackPanel>
                  <Border Background="{StaticResource BrushPrimaryLight}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
                    <StackPanel>
                      <TextBlock Text="Ví dụ: 2.000 → nghìn: &quot;Hai nghìn đồng&quot;  ·  ngàn: &quot;Hai ngàn đồng&quot;" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,1" />
                      <TextBlock Text="Ví dụ: 500.000 → nghìn: &quot;Năm trăm nghìn đồng&quot;  ·  ngàn: &quot;Năm trăm ngàn đồng&quot;" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,1" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource FluentCard}" Padding="12,10">
                <StackPanel>
                  <TextBlock Text="👁️ Xem trước theo thiết lập hiện tại" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushPrimary}" />
                  <TextBlock Text="Nhập một số tiền bất kỳ (ví dụ 2.345.000 hoặc 1.024):" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,6" />
                  <TextBox Style="{StaticResource FluentTextBox}" Margin="0,0,0,8" Text="{Binding AmountPreviewInput, UpdateSourceTrigger=PropertyChanged}" />
                  <Border Background="{StaticResource BrushPrimaryLight}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Text="{Binding AmountPreviewText}" />
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="Khôi phục mặc định" Style="{StaticResource FluentSecondaryButton}" Command="{Binding ResetCommand}" />
        <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" Text="{Binding StatusMessage}" />
        <Button Grid.Column="2" Content="💾 Lưu cấu hình" Style="{StaticResource FluentPrimaryButton}" Command="{Binding SaveCommand}" />
        <Button Grid.Column="4" Content="Đóng" Style="{StaticResource FluentSecondaryButton}" Command="{Binding CloseCommand}" />
      </Grid>
    </Border>
  </Grid>
</Window>