<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="VFormat.UI.Common.AuditReportDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Title="OfficeFormat - BÁO CÁO RÀ SOÁT THỂ THỨC" Width="560" Height="520" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Tahoma, Arial" xmlns:common="clr-namespace:VFormat.UI.Common;assembly=VFormat.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentColors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentControls.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/VectorIcons.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource BrushWindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="{StaticResource BrushPrimaryLight}" Margin="0,0,12,0" VerticalAlignment="Center">
          <Path Data="{StaticResource IconDocument}" Fill="{StaticResource BrushPrimary}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="BÁO CÁO RÀ SOÁT THỂ THỨC VĂN BẢN" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" />
          <TextBlock Text="Kết quả kiểm tra chi tiết &amp; danh mục ghi chú rà soát đã đính kèm vào Word." FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
        </StackPanel>
        <Border Grid.Column="2" CornerRadius="6" Background="#FEF3C7" Padding="8,4" VerticalAlignment="Center">
          <TextBlock Name="txtBadge" Text="Word Comments" FontSize="11" FontWeight="SemiBold" Foreground="#B45309" />
        </Border>
      </Grid>
    </Border>
    <Border Grid.Row="1" Margin="16,12" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="8">
      <TextBox Name="txtReportContent" IsReadOnly="True" Background="#00FFFFFF" BorderThickness="0" Padding="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Segoe UI, Courier New" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" />
    </Border>
    <Border Grid.Row="2" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,0" Padding="16,12">
      <Grid>
        <TextBlock Name="txtCopyFeedback" Text="" FontSize="11.5" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Name="btnCopy" Content="Sao Chép Báo Cáo" Style="{StaticResource FluentSecondaryButton}" Height="36" MinWidth="130" Margin="0,0,10,0" Click="BtnCopy_Click" />
          <Button Name="btnClose" Content="Đóng" Style="{StaticResource FluentPrimaryButton}" Height="36" MinWidth="90" Click="BtnClose_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
