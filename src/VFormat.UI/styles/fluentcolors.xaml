<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="ColorPrimary">#E04F26</Color>
  <Color x:Key="ColorPrimaryHover">#C83E18</Color>
  <Color x:Key="ColorPrimaryPressed">#A63010</Color>
  <Color x:Key="ColorPrimaryLight">#FFF1E6</Color>
  <Color x:Key="ColorAccentAmber">#F59E0B</Color>
  <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
  <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}" />
  <SolidColorBrush x:Key="BrushPrimaryPressed" Color="{StaticResource ColorPrimaryPressed}" />
  <SolidColorBrush x:Key="BrushPrimaryLight" Color="{StaticResource ColorPrimaryLight}" />
  <LinearGradientBrush x:Key="BrushPrimaryGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF7A45" Offset="0.0" />
    <GradientStop Color="#E04F26" Offset="0.55" />
    <GradientStop Color="#C23812" Offset="1.0" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="BrushSuccess" Color="#10B981" />
  <SolidColorBrush x:Key="BrushSuccessLight" Color="#DCFCE7" />
  <SolidColorBrush x:Key="BrushSuccessText" Color="#15803D" />
  <SolidColorBrush x:Key="BrushWarning" Color="#F59E0B" />
  <SolidColorBrush x:Key="BrushWarningLight" Color="#FEF3C7" />
  <SolidColorBrush x:Key="BrushWarningText" Color="#B45309" />
  <SolidColorBrush x:Key="BrushDanger" Color="#EF4444" />
  <SolidColorBrush x:Key="BrushDangerLight" Color="#FEE2E2" />
  <SolidColorBrush x:Key="BrushDangerText" Color="#B91C1C" />
  <SolidColorBrush x:Key="BrushWindowBackground" Color="#FDF8F4" />
  <SolidColorBrush x:Key="BrushCardBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BrushCardHover" Color="#FFF5EC" />
  <SolidColorBrush x:Key="BrushSubtle" Color="#FAF0E7" />
  <SolidColorBrush x:Key="BrushSeparator" Color="#EFE0D3" />
  <SolidColorBrush x:Key="BrushBorder" Color="#E2C8B5" />
  <SolidColorBrush x:Key="BrushBorderLight" Color="#EFE0D3" />
  <SolidColorBrush x:Key="BrushTextPrimary" Color="#27150E" />
  <SolidColorBrush x:Key="BrushTextSecondary" Color="#6B4C3E" />
  <SolidColorBrush x:Key="BrushTextMuted" Color="#9E7E6F" />
  <SolidColorBrush x:Key="BrushTextWhite" Color="#FFFFFF" />
</ResourceDictionary>
