<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="VFormat.UI.Templates.TemplateLibraryControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" FontFamily="Segoe UI, Tahoma, Arial" xmlns:templates="clr-namespace:VFormat.UI.Templates;assembly=VFormat.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentColors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentControls.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/VectorIcons.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource BrushWindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="0,0,0,1" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{DynamicResource FluentActionButton}" Width="32" Height="32" Padding="0" Margin="0,0,8,0" ToolTip="Quay lại danh mục trước" Command="{Binding GoBackCommand}" Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="←" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" Text="{Binding HeaderTitle}" />
          <TextBlock FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Text="{Binding HeaderSubtitle}" />
        </StackPanel>
        <Button Grid.Column="2" Style="{DynamicResource FluentActionButton}" Width="28" Height="28" Padding="0" Margin="4,0,0,0" ToolTip="Tải lại thư viện biểu mẫu" Command="{Binding RefreshCommand}">
          <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushPrimary}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource BrushWindowBackground}" Padding="12,8,12,6">
      <Grid Height="34">
        <TextBox Name="txtSearchBox" Style="{DynamicResource FluentTextBox}" Padding="28,0,26,0" VerticalContentAlignment="Center" FontSize="12" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        <Path Data="{StaticResource IconMagnifyingGlass}" Fill="{DynamicResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" />
        <TextBlock FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="28,0,0,0" IsHitTestVisible="False" Text="{Binding SearchWatermark}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Value="" Binding="{Binding Text, ElementName=txtSearchBox}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
        <Button Style="{DynamicResource FluentActionButton}" Width="22" Height="22" Padding="0" HorizontalAlignment="Right" Margin="0,0,6,0" ToolTip="Xóa tìm kiếm" Command="{Binding ClearSearchCommand}" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,4,12,12">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Categories}" Visibility="{Binding IsCategoryView, Converter={StaticResource BoolToVis}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="CategoryCard_MouseLeftButtonUp">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Border}">
                    <Style.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BrushCardHover}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource BrushPrimaryLight}" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Icon}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" Text="{Binding Name}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Text="{Binding Description}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Border Background="{DynamicResource BrushSubtle}" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                      <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding BadgeText}" />
                    </Border>
                    <TextBlock Text="›" FontSize="18" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding GroupSections}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type ItemsControl}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsCategoryView}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,2,0,10">
                <Border Background="{DynamicResource BrushWindowBackground}" BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="0,0,0,1" Padding="4,6,4,6" Margin="0,4,0,8">
                  <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="3" Height="13" Background="{DynamicResource BrushPrimary}" CornerRadius="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                      <TextBlock FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center" Text="{Binding GroupName}" />
                    </StackPanel>
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding BadgeText}" />
                  </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Templates}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type Border}">
                            <Style.Triggers>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                <Setter Property="Background" Value="{DynamicResource BrushCardHover}" />
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="{DynamicResource BrushPrimaryLight}" BorderBrush="#FCD9BD" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                              <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryHover}" Text="{Binding DisplayBadge}" />
                            </Border>
                            <Border Background="{DynamicResource BrushSubtle}" BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                              <TextBlock FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding DisplaySource}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Grid.Row="1" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,2,0,4" Text="{Binding DisplayTitle}" />
                          <TextBlock Grid.Row="2" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding Description}" />
                          <Grid Row="3">
                            <Button Style="{DynamicResource FluentPrimaryButton}" Height="28" Padding="14,0" HorizontalAlignment="Right" ToolTip="Mở tài liệu mới từ biểu mẫu này trong Word" Command="{Binding DataContext.UseTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDocument}" Fill="{DynamicResource BrushTextWhite}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Sử dụng mẫu" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,20,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="Không tìm thấy biểu mẫu phù hợp" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="Vui lòng thử tìm với từ khóa khác hoặc xóa bộ lọc tìm kiếm." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12" />
            <Button Content="Xóa tìm kiếm" Style="{DynamicResource FluentSecondaryButton}" Height="30" Padding="16,0" HorizontalAlignment="Center" Command="{Binding ClearSearchCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>