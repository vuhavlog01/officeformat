<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="VFormat.UI.Common.PrintDuplexDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OfficeFormat - IN ẤN TRANG LẺ &amp; TRANG CHẴN"
        Width="550" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Tahoma, Arial">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentColors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/FluentControls.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VFormat.UI;component/Styles/VectorIcons.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>

  <Grid Background="{StaticResource BrushWindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,0,0,1" Padding="20,12">
      <StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="🖨️ " FontSize="16" VerticalAlignment="Center" />
          <TextBlock Text="IN TRANG LẺ &amp; TRANG CHẴN (IN 2 MẶT THỦ CÔNG)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="Hỗ trợ in 2 mặt cho máy in 1 mặt, in nhanh trang chẵn/lẻ và đảo thứ tự trang." FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="26,3,0,0" />
      </StackPanel>
    </Border>

    <!-- Body -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,10">
      <StackPanel>
        <!-- Card 1: Chọn máy in -->
        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="MÁY IN HIỆN TẠI:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
            <ComboBox x:Name="cboPrinters" Height="32" VerticalContentAlignment="Center" FontSize="12" />
          </StackPanel>
        </Border>

        <!-- Card 2: Chế độ in -->
        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="CHẾ ĐỘ IN TRANG:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />
            <RadioButton x:Name="rbOdd" GroupName="PrintMode" Content="In tất cả trang lẻ (1, 3, 5, 7, 9...)" IsChecked="True" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
            <RadioButton x:Name="rbEven" GroupName="PrintMode" Content="In tất cả trang chẵn (2, 4, 6, 8, 10...)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
            <RadioButton x:Name="rbCustom" GroupName="PrintMode" Content="In theo dải trang tùy chọn (ví dụ: 1-15):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
            <Grid Margin="22,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="120" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Dải trang:" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}" />
              <TextBox x:Name="txtPages" Grid.Column="1" Style="{StaticResource FluentTextBox}" Height="28" Padding="6,2" VerticalContentAlignment="Center" Text="" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Card 3: Tùy chọn in & Số bản -->
        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="TÙY CHỌN &amp; SỐ BẢN IN:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="80" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Số bản in (Copies):" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}" />
              <TextBox x:Name="txtCopies" Grid.Column="1" Style="{StaticResource FluentTextBox}" Height="28" Padding="6,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="1" />
            </Grid>
            <CheckBox x:Name="chkReverse" Content="Đảo ngược thứ tự trang (in từ trang cuối về đầu)" FontSize="11.5" Margin="0,0,0,4" />
            <TextBlock Text="💡 Bật đảo ngược khi in mặt sau để sau khi in các trang tự sắp xếp đúng thứ tự 1, 2, 3..." FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="20,0,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Card 4: Hướng dẫn in 2 mặt bằng máy in 1 mặt -->
        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,4" Background="#F4F8FC" BorderBrush="#CCE0F5">
          <StackPanel>
            <TextBlock Text="📖 QUY TRÌNH IN 2 MẶT BẰNG MÁY IN 1 MẶT:" FontWeight="Bold" FontSize="11" Foreground="#005A9E" Margin="0,0,0,4" />
            <TextBlock Text="• Bước 1: Chọn 'In tất cả trang lẻ' ➔ Bấm [Bắt đầu In]." FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2" />
            <TextBlock Text="• Bước 2: Lấy xấp giấy từ khay ra, giữ nguyên chiều, úp mặt giấy vừa in vào lại khay nạp." FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2" />
            <TextBlock Text="• Bước 3: Chọn 'In tất cả trang chẵn' ➔ Bấm [Bắt đầu In] để hoàn tất bản in 2 mặt hoàn chỉnh." FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer buttons -->
    <Border Grid.Row="2" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="btnOddFast" Content="⚡ In Trang Lẻ" MinWidth="120" Height="35" Margin="0,0,8,0" Style="{StaticResource FluentSecondaryButton}" Click="BtnOddFast_Click" />
        <Button x:Name="btnEvenFast" Content="⚡ In Trang Chẵn" MinWidth="130" Height="35" Margin="0,0,8,0" Style="{StaticResource FluentSecondaryButton}" Click="BtnEvenFast_Click" />
        <Button x:Name="btnPrint" Content="Bắt đầu In" MinWidth="105" Height="35" Margin="0,0,8,0" Style="{StaticResource FluentPrimaryButton}" Click="BtnPrint_Click" />
        <Button x:Name="btnClose" Content="Đóng" MinWidth="80" Height="35" Style="{StaticResource FluentSecondaryButton}" Click="BtnClose_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
